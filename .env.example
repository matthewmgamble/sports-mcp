# Copy to .env for local overrides. Every setting has a safe default; see AppConfig.java.

# Public listener (MCP at /mcp, REST at /api/v1, health at /health/*)
BIND_HOST=127.0.0.1
PORT=8080

# Management listener (metrics/admin) - keep on localhost
MGMT_BIND_HOST=127.0.0.1
MGMT_PORT=9090

# SQLite database file (directory is created if missing)
DB_PATH=data/sports.db

# Timezone used for "today" when a request doesn't pass one
DEFAULT_TIMEZONE=America/New_York

# Comma-separated browser Origins allowed to call /mcp. Requests without an Origin header
# (regular MCP clients) are always allowed.
MCP_ALLOWED_ORIGINS=

# Logging: text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
