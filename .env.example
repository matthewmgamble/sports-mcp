# Copy to .env for local overrides. Every setting has a safe default; see AppConfig.java.

# Public listener (MCP at /mcp, REST at /api/v1, health at /health/*)
BIND_HOST=127.0.0.1
PORT=8080

# Management listener (metrics/admin) - keep on localhost
MGMT_BIND_HOST=127.0.0.1
MGMT_PORT=9090

# SQLite database file (directory is created if missing)
DB_PATH=data/sports.db

# Timezone used for "today" when a request doesn't pass one
DEFAULT_TIMEZONE=America/New_York

# Comma-separated browser Origins allowed to call /mcp. Requests without an Origin header
# (regular MCP clients) are always allowed.
MCP_ALLOWED_ORIGINS=

# Leagues to serve (comma-separated). Empty = all MVP leagues:
# nfl,nhl,nba,mlb,ncaaf,ncaab,epl,laliga,bundesliga (fifa exists but is off by default)
ENABLED_LEAGUES=

# Upstream base URLs (override to point at a mock server)
PROVIDER_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports
PROVIDER_NHL_BASE_URL=https://api-web.nhle.com/v1
PROVIDER_MLB_BASE_URL=https://statsapi.mlb.com/api/v1

# Background jobs: team catalogs (daily), schedule sync (full window every 6h, next 48h every
# 30 min, catch-up at startup) and retention. Turn off only for tests/debugging.
BACKGROUND_SYNC=true
# Days ahead the full schedule sync covers (plus yesterday)
SYNC_HORIZON_DAYS=14
# Games that started more than this many days ago are deleted
RETENTION_FINISHED_DAYS=90

# On-request freshness: max data age (seconds) before a request refreshes from upstream.
# One scoreboard call refreshes a whole league-day; concurrent requests share it.
FRESH_LIVE_SECONDS=15
FRESH_PREGAME_SECONDS=60
FRESH_RECENT_FINAL_SECONDS=300
# How often to re-check a league-day that had no games
FRESH_EMPTY_SECONDS=120
# Minimum gap between upstream fetches of the same scoreboard, even with refresh=true
REFRESH_FLOOR_SECONDS=5

# Bearer token for /admin/* on the management port. Blank = admin API disabled.
#   curl -X POST -H "Authorization: Bearer $ADMIN_TOKEN" "localhost:9090/admin/resync?league=nhl"
ADMIN_TOKEN=

# ---- Public-port protection -------------------------------------------------------
# Per-client budgets (client = API key if valid, else IP). Applied to /api/v1/* and MCP tool calls.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
# refresh=true beyond this is quietly treated as a normal request
RATE_LIMIT_REFRESH_PER_MIN=6
# API-key clients get this many times the anonymous limits
RATE_LIMIT_KEYED_MULTIPLIER=10
# Comma-separated SHA-256 hex of issued keys: echo -n "$KEY" | shasum -a 256
API_KEYS_SHA256=
# Peers allowed to set CF-Connecting-IP / X-Forwarded-For (Cloudflare ranges, or your proxy).
# Leave empty when clients connect directly.
TRUSTED_PROXY_CIDRS=
# Requests in flight before shedding load with 503
MAX_CONCURRENT_REQUESTS=200
# Upstream request timeout
UPSTREAM_TIMEOUT_MS=5000

# Logging: text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
